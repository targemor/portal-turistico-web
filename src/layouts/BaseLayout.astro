---
/**
 * BaseLayout.astro – Layout base compartido por todas las páginas.
 *
 * Responsabilidades:
 * - Estructura HTML completa (doctype, head, body)
 * - Meta tags SEO comunes + canonical + Open Graph / Twitter absolutos
 * - Geo tags y JSON-LD (schema.org) por página
 * - Google Fonts (carga no bloqueante)
 * - Vercel SpeedInsights/Analytics + Google Analytics 4
 * - Slot default para el contenido de cada página
 */

import SpeedInsights from '@vercel/speed-insights/astro';
import Analytics    from '@vercel/analytics/astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import {
  SITE_NAME,
  GEO,
  DEFAULT_OG_IMAGE,
  OG_IMAGE_WIDTH,
  OG_IMAGE_HEIGHT,
  absoluteUrl,
} from '../lib/seo';
import '../styles/global.css';

interface Props {
  /** Título de la pestaña / og:title */
  title?: string;
  /** Meta description */
  description?: string;
  /** URL de la imagen OG (relativa o absoluta) */
  ogImage?: string;
  /** Ruta canónica; por defecto la de la propia página */
  canonical?: string;
  /** Tipo de Open Graph */
  ogType?: string;
  /** Excluir la página de los índices de búsqueda */
  noindex?: boolean;
  /** JSON-LD de schema.org: un objeto o un array */
  jsonLd?: object | object[];
  /** Clase CSS adicional para <body> */
  bodyClass?: string;
}

const {
  title       = 'Portal Turístico Tehuacán | Cuna del Maíz',
  description = 'Portal Turístico Tehuacán – Descubre la Cuna del Maíz y Patrimonio de la Humanidad. Hoteles, restaurantes, destinos y guías certificados en Tehuacán, Puebla.',
  ogImage     = DEFAULT_OG_IMAGE,
  canonical,
  ogType      = 'website',
  noindex     = false,
  jsonLd,
  bodyClass   = '',
} = Astro.props;

const canonicalUrl = absoluteUrl(canonical ?? Astro.url.pathname);
const ogImageUrl   = absoluteUrl(ogImage);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta id="meta-desc" name="description" content={description} />
    <meta id="meta-keywords" name="keywords" content="Tehuacán, Puebla, turismo, hoteles, restaurantes, destinos turísticos, biosfera, patrimonio, México" />
    <meta name="author" content="Ayuntamiento de Tehuacán" />

    <!-- Canonical: evita duplicados por query strings (?id=, utm_*) -->
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- Open Graph (URLs absolutas: las relativas no resuelven al compartir) -->
    <meta property="og:type"        content={ogType} />
    <meta id="og-title"             property="og:title"       content={title} />
    <meta id="og-desc"              property="og:description" content={description} />
    <meta property="og:url"         content={canonicalUrl} />
    <meta property="og:image"       content={ogImageUrl} />
    <meta property="og:image:width"  content={String(OG_IMAGE_WIDTH)} />
    <meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />
    <meta property="og:image:alt"   content={title} />
    <meta property="og:site_name"   content={SITE_NAME} />
    <meta id="og-locale"            property="og:locale"      content="es_MX" />

    <!-- Twitter Card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta id="tw-title"              name="twitter:title"       content={title} />
    <meta id="tw-desc"               name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImageUrl} />
    <meta name="twitter:image:alt"   content={title} />

    <!-- Geo tags: búsqueda local -->
    <meta name="geo.region"    content={GEO.region} />
    <meta name="geo.placename" content={GEO.placename} />
    <meta name="geo.position"  content={`${GEO.lat};${GEO.lng}`} />
    <meta name="ICBM"          content={`${GEO.lat}, ${GEO.lng}`} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>

    <!-- ─── Google Fonts: carga no bloqueante ──────────────────────── -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap"
    />
    <link
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap"
      />
    </noscript>

    <!-- ─── Google Analytics 4 (no se emite si falta PUBLIC_GA_ID) ─── -->
    <GoogleAnalytics />

    <!-- ─── JSON-LD schema.org ──────────────────────────────────────── -->
    {
      jsonLd && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(Array.isArray(jsonLd) ? jsonLd : [jsonLd])}
        />
      )
    }

    <!-- Slot para meta tags adicionales específicos de cada página (preloads, etc.) -->
    <slot name="head" />
  </head>

  <body class={`min-h-screen bg-slate-50/50 text-slate-900 font-sans selection:bg-brand/10 pb-20 md:pb-0 ${bodyClass}`}>

    <!-- Contenido de la página -->
    <slot />

    <!-- ─── Vercel: SpeedInsights + Analytics ───────────────────────
         Colocados al final del body para no bloquear el renderizado.
         Al estar en el layout base, instrumentan TODAS las páginas.
    ──────────────────────────────────────────────────────────────── -->
    <SpeedInsights />
    <Analytics />

    <!-- ─── i18n sync for static Astro components ─────────────────
         Listens to the 'portal:lang-change' event fired by LanguageContext
         and updates data-i18n elements and meta tags accordingly.
    ──────────────────────────────────────────────────────────────── -->
    <script>
      import translations from '../i18n/translations.json';

      (function () {
        const T = translations as Record<string, Record<string, string>>;

        function applyLang(lang: string) {
          const t = T[lang] || T.es;

          // Meta / SEO
          document.title = t.pageTitle;
          document.documentElement.lang = lang;
          const set = (id: string, attr: string, val: string) => { const el = document.getElementById(id); if (el) el.setAttribute(attr, val); };
          set('meta-desc',    'content', t.description);
          set('meta-keywords','content', t.keywords);
          set('og-title',     'content', t.pageTitle);
          set('og-desc',      'content', t.description);
          set('og-locale',    'content', t.ogLocale);
          set('tw-title',     'content', t.pageTitle);
          set('tw-desc',      'content', t.description);

          // data-i18n elements
          document.querySelectorAll('[data-i18n]').forEach(el => {
            const key = el.getAttribute('data-i18n');
            if (key && t[key] !== undefined) {
              if (el.getAttribute('data-i18n-html') === 'true') {
                el.innerHTML = t[key];
              } else {
                el.textContent = t[key];
              }
            }
          });
        }

        // Init from localStorage
        const saved = localStorage.getItem('portal-lang');
        const lang = (saved === 'es' || saved === 'en') ? saved : 'es';
        applyLang(lang);

        // Listen to React context changes
        document.addEventListener('portal:lang-change', (e: Event) => {
          const customEvent = e as CustomEvent<{ lang: string }>;
          if (customEvent.detail?.lang) {
            applyLang(customEvent.detail.lang);
          }
        });
      })();
    </script>

  </body>
</html>
