---
/**
 * DestinosSection – Sección de destinos turísticos
 */
import ReactCard from "./react/Card";
import FacebookIcon from "../assets/icons/FacebookIcon.astro";
import InstagramIcon from "../assets/icons/InstagramIcon.astro";
import TikTokIcon from "../assets/icons/TikTokIcon.astro";
import YouTubeIcon from "../assets/icons/YouTubeIcon.astro";

import type { Destino } from "../types";

interface Props {
  destinos: Destino[];
}

const { destinos } = Astro.props;

const SocialIconComponents: Record<string, any> = {
  Facebook: FacebookIcon,
  Instagram: InstagramIcon,
  TikTok: TikTokIcon,
  YouTube: YouTubeIcon,
};
---

<section id="destinos" class="section-padding bg-stone-950">
  <div class="container-xl">
    <!-- Header -->
    <div class="text-center mb-16">
      <div class="inline-flex items-center rounded-full border border-transparent bg-brand px-2.5 py-0.5 text-xs font-semibold text-white transition-colors mb-4">
        Explora Tehuacán
      </div>
      <h2 class="text-4xl md:text-5xl font-bold text-stone-100 mt-2">
        Destinos <span class="gradient-text">Turísticos</span>
      </h2>
      <div class="section-divider mt-4 mb-6"></div>
      <p class="text-stone-400 text-lg max-w-xl mx-auto">
        Descubre los lugares más fascinantes que Tehuacán tiene para ofrecer.
      </p>
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {destinos.map((destino) => (
        <ReactCard client:visible item={destino} categoria="destinos">
          {/* Social media */}
          {destino.redes_sociales && destino.redes_sociales.length > 0 && (
            <div class="flex items-center gap-2 pt-2 mt-2 border-t border-slate-100">
              {destino.redes_sociales.map((red) => {
                const Icon = SocialIconComponents[red.plataforma];
                return (
                  <a
                    href={red.enlace ?? "#"}
                    target={red.enlace ? "_blank" : undefined}
                    rel="noopener noreferrer"
                    aria-label={red.plataforma}
                    class="w-8 h-8 rounded-lg flex items-center justify-center text-slate-400 hover:text-brand bg-slate-100 hover:bg-slate-200 transition-all duration-200"
                  >
                    {Icon && <Icon class="w-4 h-4" />}
                  </a>
                );
              })}
            </div>
          )}
        </ReactCard>
      ))}
    </div>
  </div>
</section>
