---
/**
 * DestinosSection – Sección de destinos turísticos
 */
import Card from "./ui/Card.astro";
import Badge from "./ui/Badge.astro";
import Button from "./ui/Button.astro";

interface RedSocial {
  id: number;
  plataforma: string;
  usuario: string | null;
  enlace: string | null;
}

interface Destino {
  id: number;
  documentId: string;
  nombre: string;
  descripcion: string | null;
  direccion: string;
  contacto: unknown | null;
  galeria: unknown | null;
  redes_sociales: RedSocial[];
  createdAt: string;
  updatedAt: string;
  publishedAt: string;
}

interface Props {
  destinos: Destino[];
}

const { destinos } = Astro.props;

const socialIcons: Record<string, string> = {
  Facebook: `<svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4" aria-hidden="true"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>`,
  Instagram: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>`,
  TikTok: `<svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4" aria-hidden="true"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.34 6.34 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.77a8.18 8.18 0 004.78 1.52V6.83a4.85 4.85 0 01-1.01-.14z"/></svg>`,
  YouTube: `<svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4" aria-hidden="true"><path d="M22.54 6.42a2.78 2.78 0 00-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46a2.78 2.78 0 00-1.95 1.96A29 29 0 001 12a29 29 0 00.46 5.58 2.78 2.78 0 001.95 1.95C5.12 20 12 20 12 20s6.88 0 8.59-.47a2.78 2.78 0 001.95-1.95A29 29 0 0023 12a29 29 0 00-.46-5.58z"/><polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02" fill="white"/></svg>`,
};
---

<section id="destinos" class="section-padding bg-stone-950">
  <div class="container-xl">
    <!-- Header -->
    <div class="text-center mb-16">
      <Badge variant="default" class="mb-4">
        <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/><circle cx="12" cy="9" r="2.5"/>
        </svg>
        Explora Tehuacán
      </Badge>
      <h2 class="text-4xl md:text-5xl font-bold text-stone-100 mt-2">
        Destinos <span class="gradient-text">Turísticos</span>
      </h2>
      <div class="section-divider mt-4 mb-6"></div>
      <p class="text-stone-400 text-lg max-w-xl mx-auto">
        Descubre los lugares más fascinantes que Tehuacán tiene para ofrecer.
      </p>
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {destinos.map((destino, index) => (
        <Card id={`destino-${destino.id}`} class="group flex flex-col">
          <!-- Image placeholder (no galería) -->
          <div class="relative h-52 bg-gradient-to-br from-amber-900/30 via-stone-800 to-stone-900 overflow-hidden">
            <div class="absolute inset-0 flex items-center justify-center">
              <svg class="w-16 h-16 text-amber-600/30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true">
                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/>
                <circle cx="12" cy="9" r="3"/>
              </svg>
            </div>
            <!-- Decorative stripes -->
            <div class="absolute inset-0 opacity-10" style="background: repeating-linear-gradient(45deg, transparent, transparent 10px, rgba(217,119,6,0.3) 10px, rgba(217,119,6,0.3) 11px);"></div>
            <div class="absolute top-3 right-3">
              <Badge variant="default">Turismo</Badge>
            </div>
          </div>

          <!-- Content -->
          <div class="flex flex-col flex-1 p-5 gap-3">
            <h3 class="text-lg font-semibold text-stone-100 group-hover:text-amber-400 transition-colors leading-tight">
              {destino.nombre}
            </h3>

            {destino.descripcion && (
              <p class="text-sm text-stone-400 line-clamp-2 leading-relaxed">
                {destino.descripcion}
              </p>
            )}

            <!-- Address -->
            <div class="flex items-start gap-2 text-sm text-stone-400">
              <svg class="w-4 h-4 text-amber-600 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/>
                <circle cx="12" cy="9" r="2.5"/>
              </svg>
              <span class="leading-relaxed">{destino.direccion}</span>
            </div>

            <!-- Social media -->
            {destino.redes_sociales.length > 0 && (
              <div class="flex items-center gap-2 pt-1">
                {destino.redes_sociales.map((red) => (
                  <a
                    href={red.enlace ?? "#"}
                    target={red.enlace ? "_blank" : undefined}
                    rel="noopener noreferrer"
                    aria-label={red.plataforma}
                    class="w-8 h-8 rounded-lg flex items-center justify-center text-stone-400 hover:text-amber-400 bg-stone-800 hover:bg-stone-700 transition-all duration-200"
                    set:html={socialIcons[red.plataforma] ?? ""}
                  />
                ))}
              </div>
            )}

            <!-- Spacer -->
            <div class="flex-1"></div>

            <!-- Footer -->
            <div class="pt-3 border-t border-stone-800 mt-2">
              <Button variant="outline" size="sm" class="w-full">
                Ver más detalles
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </Button>
            </div>
          </div>
        </Card>
      ))}
    </div>
  </div>
</section>
