---
/**
 * ExploraSection – "Explora cada rincón" bento grid con tabs
 * Fiel al diseño de test.jsx: bg-white, tabs con #701010 activo,
 * bento grid 8+4 col, imágenes Unsplash
 */

const categories = [
  { id: "Naturaleza", label: "Biosfera",    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4" aria-hidden="true"><path d="M17 8c0 5.5-5 10-5 10S7 13.5 7 8a5 5 0 0110 0z"/><path d="M12 18v4"/></svg>` },
  { id: "Sabor",      label: "Gastronomía", icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4" aria-hidden="true"><path d="M18 8h1a4 4 0 010 8h-1"/><path d="M2 8h16v9a4 4 0 01-4 4H6a4 4 0 01-4-4V8z"/><line x1="6" y1="1" x2="6" y2="4"/><line x1="10" y1="1" x2="10" y2="4"/><line x1="14" y1="1" x2="14" y2="4"/></svg>` },
  { id: "Historia",   label: "Cultura",     icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>` },
  { id: "Wellness",   label: "Manantiales", icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4" aria-hidden="true"><path d="M12 2.69l5.66 5.66a8 8 0 11-11.31 0z"/></svg>` },
];

const discoveryItems = [
  {
    id: 1,
    title: "Reserva de la Biosfera Tehuacán-Cuicatlán",
    description: "Explora el bosque de cactáceas columnares más grande del mundo, Patrimonio de la Humanidad.",
    image: "https://images.unsplash.com/photo-1504280390367-361c6d9f38f4?q=80&w=800&auto=format&fit=crop",
  },
  {
    id: 2,
    title: "Museo de la Evolución",
    description: "Un viaje desde el Big Bang hasta la megafauna que habitó la región de Tehuacán.",
    image: "https://images.unsplash.com/photo-1518998053574-53f1f61f90ee?q=80&w=600&auto=format&fit=crop",
  },
  {
    id: 3,
    title: "Matanza Tradicional",
    description: "Vive el sabor único del Mole de Caderas, un pilar culinario de la región poblana.",
    image: "https://images.unsplash.com/photo-1599974579688-8dbdd335c77f?q=80&w=600&auto=format&fit=crop",
  },
];
---

<section class="py-24 bg-white border-y border-slate-100">
  <div class="container mx-auto px-6">
    <!-- Header + Tabs -->
    <div class="text-center mb-12">
      <h2 class="text-3xl font-bold tracking-tight mb-4 text-slate-900">EXPLORA CADA RINCÓN</h2>

      <div class="flex flex-wrap justify-center gap-2 mt-8" id="explora-tabs" role="tablist" aria-label="Categorías">
        {categories.map((cat, i) => (
          <button
            role="tab"
            id={`tab-${cat.id}`}
            aria-selected={i === 0 ? "true" : "false"}
            aria-controls="explora-panel"
            data-cat={cat.id}
            class={`tab-btn inline-flex items-center gap-2 rounded-md px-4 py-2 text-xs font-bold uppercase tracking-wider transition-all border ${
              i === 0
                ? "bg-[#701010] border-[#701010] text-white shadow-sm"
                : "bg-white border-slate-200 text-slate-500 hover:border-slate-300"
            }`}
          >
            <span set:html={cat.icon} />
            {cat.label}
          </button>
        ))}
      </div>
    </div>

    <!-- Bento grid -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 md:h-[600px]">
      <!-- Large card -->
      <div class="md:col-span-8 relative rounded-2xl overflow-hidden group shadow-sm">
        <img
          src={discoveryItems[0].image}
          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
          alt={discoveryItems[0].title}
          loading="lazy"
          decoding="async"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-slate-950/20 to-transparent"></div>
        <div class="absolute bottom-10 left-10 right-10">
          <div class="inline-flex items-center rounded-full border border-transparent bg-white px-2.5 py-0.5 text-xs font-semibold text-[#701010] mb-4">
            Recomendado
          </div>
          <h3 class="text-white text-3xl font-bold mb-2">{discoveryItems[0].title}</h3>
          <p class="text-white/70 max-w-lg mb-6 text-sm">{discoveryItems[0].description}</p>
          <a
            href="#destinos"
            class="inline-flex items-center justify-center rounded-full px-6 py-2 bg-[#701010] text-white text-xs font-black uppercase hover:bg-[#5a0d0d] transition-colors"
          >
            Planear visita
          </a>
        </div>
      </div>

      <!-- Small cards -->
      <div class="md:col-span-4 grid grid-rows-2 gap-6">
        {discoveryItems.slice(1).map((item) => (
          <div class="relative rounded-2xl overflow-hidden group shadow-sm">
            <img
              src={item.image}
              class="w-full h-full object-cover grayscale-[20%] group-hover:grayscale-0 transition-all duration-700"
              alt={item.title}
              loading="lazy"
              decoding="async"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent"></div>
            <div class="absolute bottom-8 left-8 right-8">
              <h3 class="text-white text-lg font-bold mb-1">{item.title}</h3>
              <button class="text-white/80 text-xs font-bold uppercase tracking-widest border-b border-white/20 pb-0.5 hover:text-white transition-colors">
                Descubrir
              </button>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const tabBtns = document.querySelectorAll<HTMLButtonElement>(".tab-btn");

  tabBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      tabBtns.forEach((b) => {
        b.classList.remove("bg-[#701010]", "border-[#701010]", "text-white", "shadow-sm");
        b.classList.add("bg-white", "border-slate-200", "text-slate-500");
        b.setAttribute("aria-selected", "false");
      });
      btn.classList.add("bg-[#701010]", "border-[#701010]", "text-white", "shadow-sm");
      btn.classList.remove("bg-white", "border-slate-200", "text-slate-500");
      btn.setAttribute("aria-selected", "true");
    });
  });
</script>
