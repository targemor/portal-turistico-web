---
/**
 * NavBar.astro – Delegado a AppShell (React) que incluye NavBar + BottomNav
 * bajo un único LanguageProvider.
 * Este wrapper solo monta el AppShell para que Astro lo hidrate.
 */
import AppShell from "./react/AppShell";

interface Props {
  forceBackground?: boolean;
}

const { forceBackground = false } = Astro.props;
---

<AppShell forceNavBackground={forceBackground} client:load />
