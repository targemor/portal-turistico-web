---
/**
 * GuiasSection – Guías turísticos desde JSON, estilo fiel a test.jsx
 */
import ReactCard from "./react/Card";
import Button from "./ui/Button.astro";
import ArrowRightIcon from "../assets/icons/ArrowRightIcon.astro";
import PhoneIcon from "../assets/icons/PhoneIcon.astro";
import MailIcon from "../assets/icons/MailIcon.astro";
import FacebookIcon from "../assets/icons/FacebookIcon.astro";
import InstagramIcon from "../assets/icons/InstagramIcon.astro";

import type { Guia } from "../types";

interface Props {
  guias: Guia[];
}

const { guias } = Astro.props;

const SocialIconComponents: Record<string, any> = {
  Facebook: FacebookIcon,
  Instagram: InstagramIcon,
};
---

<section id="guias" class="py-20 bg-white border-y border-slate-100">
  <div class="container mx-auto px-6">
    <!-- Header -->
    <div class="flex flex-col md:flex-row justify-between items-end mb-12 gap-4">
      <div>
        <p class="text-brand font-bold text-xs uppercase tracking-[0.3em] mb-2" data-i18n="guideBadge">Certificados SECTUR</p>
        <h2 class="text-3xl font-bold tracking-tight text-slate-900" data-i18n="guideTitle">GUÍAS TURÍSTICOS</h2>
      </div>
      <Button href="/directorio/guias" variant="outline" class="text-xs font-bold gap-2">
        <span data-i18n="guideCta">VER TODOS LOS GUÍAS</span>
        <ArrowRightIcon class="w-3.5 h-3.5" />
      </Button>
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {guias.map((guia) => (
        <ReactCard client:visible item={guia} categoria="guias">
          {/* Subtítulo SECTUR */}
          {guia.credencial_sectur === "Sí" && (
            <p class="text-xs text-brand font-semibold mb-4 uppercase tracking-wide" data-i18n="guideCertified">
              Guía Certificado por SECTUR
            </p>
          )}

          {/* Contacto */}
          {guia.contacto && (
            <div class="mb-4 flex flex-col gap-1.5 text-sm text-slate-500">
              {guia.contacto.telefono && (
                <a href={`tel:${guia.contacto.telefono}`} class="flex items-center gap-2 hover:text-brand transition-colors">
                  <PhoneIcon class="w-3.5 h-3.5 text-slate-400 shrink-0" />
                  {guia.contacto.telefono}
                </a>
              )}
              {guia.contacto.email && (
                <a href={`mailto:${guia.contacto.email}`} class="flex items-center gap-2 hover:text-brand transition-colors">
                  <MailIcon class="w-3.5 h-3.5 text-slate-400 shrink-0" />
                  {guia.contacto.email}
                </a>
              )}
            </div>
          )}

        </ReactCard>
      ))}
    </div>
  </div>
</section>
