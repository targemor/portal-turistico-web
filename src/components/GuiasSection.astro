---
/**
 * GuiasSection – Guías turísticos desde JSON, estilo fiel a test.jsx
 * bg-white, border-slate-200, var(--color-brand) acento
 */
import Card from "./ui/Card.astro";
import Badge from "./ui/Badge.astro";
import Button from "./ui/Button.astro";

interface RedSocial {
  id: number;
  plataforma: string;
  usuario: string | null;
  enlace: string | null;
}

interface Contacto {
  id: number;
  telefono: string | null;
  email: string | null;
  sitio_web: string | null;
  whatsapp: string | null;
}

interface Guia {
  id: number;
  documentId: string;
  nombre: string;
  credencial_sectur: string | null;
  contacto: Contacto | null;
  galeria: unknown | null;
  redes_sociales: RedSocial[];
  createdAt: string;
  updatedAt: string;
  publishedAt: string;
}

interface Props {
  guias: Guia[];
}

const { guias } = Astro.props;

const socialIcons: Record<string, string> = {
  Facebook:  `<svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4" aria-hidden="true"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>`,
  Instagram: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>`,
};
---

<section id="guias" class="py-20 bg-white border-y border-slate-100">
  <div class="container mx-auto px-6">
    <!-- Header -->
    <div class="flex flex-col md:flex-row justify-between items-end mb-12 gap-4">
      <div>
        <p class="text-brand font-bold text-xs uppercase tracking-[0.3em] mb-2">Certificados SECTUR</p>
        <h2 class="text-3xl font-bold tracking-tight text-slate-900">GUÍAS TURÍSTICOS</h2>
      </div>
      <Button variant="outline" class="text-xs font-bold gap-2">
        VER TODOS LOS GUÍAS
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M9 18l6-6-6-6"/>
        </svg>
      </Button>
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {guias.map((guia) => (
        <Card id={`guia-${guia.id}`} class="overflow-hidden group">
          <!-- Avatar header -->
          <div class="aspect-video bg-slate-100 flex items-center justify-center overflow-hidden relative">
            <div class="w-20 h-20 rounded-full bg-slate-200 flex items-center justify-center border-4 border-white shadow-sm">
              <svg class="w-10 h-10 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/>
              </svg>
            </div>
            {guia.credencial_sectur === "Sí" && (
              <div class="absolute top-3 right-3">
                <Badge>✓ SECTUR</Badge>
              </div>
            )}
          </div>

          <!-- Contenido -->
          <div class="p-6">
            <h3 class="text-xl font-bold mb-1 text-slate-900">{guia.nombre}</h3>

            {guia.credencial_sectur === "Sí" && (
              <p class="text-xs text-brand font-semibold mb-4 uppercase tracking-wide">
                Guía Certificado por SECTUR
              </p>
            )}

            <!-- Contacto -->
            {guia.contacto && (
              <div class="mb-4 flex flex-col gap-1.5 text-sm text-slate-500">
                {guia.contacto.telefono && (
                  <a href={`tel:${guia.contacto.telefono}`} class="flex items-center gap-2 hover:text-brand transition-colors">
                    <svg class="w-3.5 h-3.5 text-slate-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 12a19.79 19.79 0 01-3.07-8.67A2 2 0 012 1.84h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L6.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/>
                    </svg>
                    {guia.contacto.telefono}
                  </a>
                )}
                {guia.contacto.email && (
                  <a href={`mailto:${guia.contacto.email}`} class="flex items-center gap-2 hover:text-brand transition-colors">
                    <svg class="w-3.5 h-3.5 text-slate-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
                    </svg>
                    {guia.contacto.email}
                  </a>
                )}
              </div>
            )}

            <!-- Redes sociales -->
            {guia.redes_sociales.length > 0 && (
              <div class="flex gap-2 mb-5">
                {guia.redes_sociales.map((red) => (
                  <a
                    href={red.enlace ?? "#"}
                    target={red.enlace ? "_blank" : undefined}
                    rel="noopener noreferrer"
                    aria-label={red.plataforma}
                    class="w-8 h-8 rounded-md flex items-center justify-center text-slate-400 hover:text-brand border border-slate-200 hover:border-brand/30 bg-white transition-all"
                    set:html={socialIcons[red.plataforma] ?? ""}
                  />
                ))}
              </div>
            )}

            <Button variant="outline" class="w-full group-hover:bg-brand group-hover:text-white transition-all">
              Contactar guía
            </Button>
          </div>
        </Card>
      ))}
    </div>
  </div>
</section>
