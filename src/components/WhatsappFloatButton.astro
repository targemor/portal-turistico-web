---
/**
 * WhatsappFloatButton – Botón flotante "Guía local" con enlace a WhatsApp.
 * Portado de sitio-cholula (`Layout.astro` + `styles/layout.css`); sustituye
 * al botón redondo anterior, que además apuntaba a un href vacío.
 *
 * Se monta desde BottomNav.astro, presente en todas las páginas.
 * En móvil se eleva por encima del BottomNav de React (57px de alto, z-50).
 */

/** Número del portal, 10 dígitos sin lada internacional. */
const TELEFONO = "2380000000";

interface Props {
  /** Sobrescribe el número por defecto (10 dígitos, sin +52). */
  telefono?: string;
  /** Mensaje con el que se abre el chat. */
  mensaje?: string;
}

const {
  telefono = TELEFONO,
  mensaje = "Hola, me gustaría información turística sobre Tehuacán.",
} = Astro.props;

const href = `https://api.whatsapp.com/send?phone=52${telefono.replace(/\D/g, "")}&text=${encodeURIComponent(mensaje)}`;
---

<a
  {href}
  class="whatsapp-fab"
  id="whatsapp-fab"
  target="_blank"
  rel="noopener noreferrer"
  data-ga-whatsapp="true"
>
  <span class="whatsapp-fab-badge">
    <span class="ai-sparkle" aria-hidden="true">🤖</span>
    <span class="ai-text" data-i18n="waLabel">Guía local</span>
  </span>
  <span class="whatsapp-icon-wrapper">
    <svg viewBox="0 0 448 512" width="24" height="24" aria-hidden="true">
      <path
        fill="white"
        d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-23.1-115-65-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-2.1-3.6 .1-5.5 1.8-7.3 1.6-1.6 3.7-4.2 5.5-6.3 1.8-2.1 2.4-3.7 3.6-6.2 1.2-2.5 .6-4.7-.3-6.2-1.9-3.4-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"
      ></path>
    </svg>
  </span>
  <!-- Contexto para lectores de pantalla; se traduce con el mismo mecanismo
       data-i18n que el resto (un aria-label no lo haría, el script solo
       reescribe textContent). -->
  <span class="sr-only" data-i18n="waAria">Contactar por WhatsApp</span>
</a>

<style>
  .whatsapp-fab {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 999;
    display: flex;
    align-items: center;
    gap: 10px;
    background: linear-gradient(135deg, #25d366 0%, #128c7e 100%);
    background-size: 200% 200%;
    animation: whatsappGradient 4s ease infinite;
    color: #fff;
    text-decoration: none;
    padding: 10px 18px 10px 16px;
    border-radius: 9999px;
    box-shadow: 0 6px 22px rgba(37, 211, 102, 0.45);
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  .whatsapp-fab-badge {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.92rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    color: #ffffff;
    white-space: nowrap;
  }

  .ai-sparkle {
    font-size: 1.15rem;
    line-height: 1;
  }

  .whatsapp-icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .whatsapp-fab:hover {
    transform: translateY(-3px) scale(1.05);
    box-shadow: 0 10px 28px rgba(37, 211, 102, 0.65);
  }

  .whatsapp-fab:focus-visible {
    outline: 3px solid #0f172a;
    outline-offset: 3px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  /* Por encima del BottomNav (57px de alto, solo visible bajo el breakpoint md) */
  @media (max-width: 767px) {
    .whatsapp-fab {
      bottom: calc(73px + env(safe-area-inset-bottom, 0px));
      right: 16px;
      padding: 8px 14px 8px 12px;
    }

    .whatsapp-fab-badge {
      font-size: 0.84rem;
    }
  }

  @keyframes whatsappGradient {
    0% {
      background-position: 0% 50%;
    }

    50% {
      background-position: 100% 50%;
    }

    100% {
      background-position: 0% 50%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .whatsapp-fab {
      animation: none;
      transition: none;
    }

    .whatsapp-fab:hover {
      transform: none;
    }
  }
</style>
