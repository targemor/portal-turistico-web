---
/**
 * Footer – fiel al diseño de test.jsx
 * bg-slate-950 dark, texto slate-400, acento var(--color-brand)
 * Sin lucide-react: iconos inline SVG
 */
import MapPinIcon from "../assets/icons/MapPinIcon.astro";
import MessageCircleIcon from "../assets/icons/MessageCircleIcon.astro";
import ExternalLinkIcon from "../assets/icons/ExternalLinkIcon.astro";
---

<footer class="bg-slate-950 text-white py-20 pb-32 md:pb-20">
  <div class="container mx-auto px-6">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-16">

      <!-- Brand -->
      <div class="md:col-span-2">
        <h2 class="text-4xl font-black tracking-tighter mb-8 flex gap-1">
          <span style="color: #C82E31;">M</span>
          <span style="color: #E6007E;">É</span>
          <span style="color: #F39200;">X</span>
          <span style="color: #7D287E;">I</span>
          <span style="color: #82BC00;">C</span>
          <span style="color: #009BA4;">O</span>
        </h2>
        <p class="text-slate-400 max-w-md mb-10 text-lg leading-relaxed font-medium">
          Tehuacán te espera con los brazos abiertos. Vive la magia de sus manantiales y la majestuosidad de su biosfera en una explosión de cultura.
        </p>     
      </div>


      <!-- Quick links -->
      <div>
        <h4 class="text-[10px] font-black uppercase tracking-[0.2em] text-brand mb-6">Explora</h4>
        <ul class="space-y-3 text-sm text-slate-400 font-bold">
          <li><a href="#hoteles"      class="hover:text-white transition-colors">Donde hospedarse</a></li>
          <li><a href="#restaurantes" class="hover:text-white transition-colors">Donde comer</a></li>
          <li><a href="#destinos"     class="hover:text-white transition-colors">Que hacer</a></li>
          <li><a href="#guias"        class="hover:text-white transition-colors">Guias Turisticos</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="text-[10px] font-black uppercase tracking-[0.2em] text-brand mb-6">Contacto</h4>
        <ul class="space-y-4 text-sm text-slate-400">
          <li class="flex items-center gap-3">
            <MapPinIcon class="w-4 h-4 text-slate-600 shrink-0" />
            Centro Histórico, Tehuacán
          </li>
          <li class="flex items-center gap-3">
            <MessageCircleIcon class="w-4 h-4 text-slate-600 shrink-0" />
            WhatsApp Oficial
          </li>
          <li class="flex items-center gap-3">
            <ExternalLinkIcon class="w-4 h-4 text-slate-600 shrink-0" />
            Portal del Ayuntamiento
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="pt-8 border-t border-slate-900 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-[10px] font-bold uppercase tracking-widest text-slate-600">
        Ayuntamiento de Tehuacán 2024-2027
      </p>
      <div class="flex gap-6 text-[10px] font-bold text-slate-600 uppercase">
        <a href="#" class="cursor-pointer hover:text-white transition-colors">Privacidad</a>
        <a href="#" class="cursor-pointer hover:text-white transition-colors">Directorio</a>
      </div>
    </div>
  </div>
</footer>
