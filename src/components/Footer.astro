---
/**
 * Footer – fiel al diseño de test.jsx
 * bg-slate-950 dark, texto slate-400, acento var(--color-brand)
 */
import MapPinIcon from "../assets/icons/MapPinIcon.astro";
import MessageCircleIcon from "../assets/icons/MessageCircleIcon.astro";
import ExternalLinkIcon from "../assets/icons/ExternalLinkIcon.astro";
---

<footer class="bg-slate-950 text-white py-20 pb-32 md:pb-20">
  <div class="container mx-auto px-6">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-16">

      <!-- Brand -->
      <div class="md:col-span-2">
        <h2 class="text-4xl font-black tracking-tighter mb-8 flex gap-1">
          <span style="color: var(--color-mex-rojo);">M</span>
          <span style="color: var(--color-mex-rosa);">É</span>
          <span style="color: var(--color-mex-naranja);">X</span>
          <span style="color: var(--color-mex-purpura);">I</span>
          <span style="color: var(--color-mex-verde);">C</span>
          <span style="color: var(--color-mex-turquesa);">O</span>
        </h2>
        <p class="text-slate-400 max-w-md mb-10 text-lg leading-relaxed font-medium" data-i18n="footerTagline">
          Tehuacán te espera con los brazos abiertos. Vive la magia de sus manantiales y la majestuosidad de su biosfera en una explosión de cultura.
        </p>
      </div>

      <!-- Quick links -->
      <div>
        <h3 class="text-[10px] font-black uppercase tracking-[0.2em] text-brand mb-6" data-i18n="footerExplore">Explora</h3>
        <ul class="space-y-3 text-sm text-slate-400 font-bold">
          <li><a href="#hoteles"      class="hover:text-white transition-colors" data-i18n="footerWhere">Donde hospedarse</a></li>
          <li><a href="#restaurantes" class="hover:text-white transition-colors" data-i18n="footerEat">Donde comer</a></li>
          <li><a href="#destinos"     class="hover:text-white transition-colors" data-i18n="footerDo">Que hacer</a></li>
          <li><a href="#guias"        class="hover:text-white transition-colors" data-i18n="footerGuides">Guías Turísticos</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="text-[10px] font-black uppercase tracking-[0.2em] text-brand mb-6" data-i18n="footerContact">Contacto</h3>
        <ul class="space-y-4 text-sm text-slate-400">
          <li class="flex items-center gap-3">
            <MapPinIcon class="w-4 h-4 text-slate-600 shrink-0" />
            <span data-i18n="footerAddress">Centro Histórico, Tehuacán</span>
          </li>
          <li class="flex items-center gap-3">
            <MessageCircleIcon class="w-4 h-4 text-slate-600 shrink-0" />
            <span data-i18n="footerWhatsapp">WhatsApp Oficial</span>
          </li>
          <li class="flex items-center gap-3">
            <ExternalLinkIcon class="w-4 h-4 text-slate-600 shrink-0" />
            <span data-i18n="footerPortal">Portal del Ayuntamiento</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="pt-8 border-t border-slate-900 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-[10px] font-bold uppercase tracking-widest text-slate-600" data-i18n="footerCopy">
        Ayuntamiento de Tehuacán 2024-2027
      </p>
      <div class="flex gap-6 text-[10px] font-bold text-slate-600 uppercase">
        <a href="#" class="cursor-pointer hover:text-white transition-colors" data-i18n="footerPrivacy">Privacidad</a>
        <a href="#" class="cursor-pointer hover:text-white transition-colors" data-i18n="footerDir">Directorio</a>
      </div>
    </div>
  </div>
</footer>
