---
/**
 * ImperdiblesSection – "Los Imperdibles" con Cards multicolor
 * Fiel a page.tsx: barra superior animada, badges y botones con color por categoría
 */

const imperdibles = [
  {
    id: "san-juan-raya",
    categoria: "Naturaleza",
    titulo: "San Juan Raya",
    descripcion: "Fósiles marinos y rutas de senderismo en el corazón de la biosfera.",
    imagen: "https://images.unsplash.com/photo-1523712999610-f77fbcfc3843?q=80&w=800&auto=format&fit=crop",
    cta: "Saber más",
    color: "#82BC00",
  },
  {
    id: "sabor-local",
    categoria: "Sabor",
    titulo: "Manjares del Valle",
    descripcion: "Deleita tu paladar con los muéganos y el tradicional mole de caderas.",
    imagen: "https://images.unsplash.com/photo-1552566626-52f8b828add9?q=80&w=800&auto=format&fit=crop",
    cta: "Ver menú",
    color: "#F39200",
  },
  {
    id: "manantiales",
    categoria: "Wellness",
    titulo: "Aguas Minerales",
    descripcion: "Relajación total en los manantiales curativos de fama mundial.",
    imagen: "https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?q=80&w=800&auto=format&fit=crop",
    cta: "Reservar",
    color: "#009BA4",
  },
];
---

<section id="destinos" class="py-20">
  <div class="container mx-auto px-6">
    <!-- Header -->
    <div class="flex justify-between items-center mb-16">
      <h2 class="text-4xl font-black tracking-tighter">LOS IMPERDIBLES</h2>
      <div class="h-px flex-1 mx-8 bg-slate-200 hidden md:block"></div>
      <a
        href="#"
        class="inline-flex items-center justify-center rounded-full border-2 px-4 py-2 text-xs font-black uppercase tracking-wider transition-all hover:text-white"
        style="border-color: #7D287E; color: #7D287E;"
        onmouseover="this.style.backgroundColor='#7D287E'; this.style.color='white';"
        onmouseout="this.style.backgroundColor='transparent'; this.style.color='#7D287E';"
      >
        EXPLORAR TODO
      </a>
    </div>

    <!-- Grid de cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {imperdibles.map((item) => (
        <div class="group rounded-2xl border border-slate-200 bg-white shadow-sm transition-all hover:shadow-xl overflow-hidden">
          <!-- Barra superior animada con color de categoría -->
          <div
            class="h-1.5 w-full transition-transform duration-500 origin-left group-hover:scale-x-110"
            style={`background-color: ${item.color};`}
          ></div>
          <!-- Imagen -->
          <div class="aspect-[4/3] overflow-hidden relative">
            <img
              src={item.imagen}
              alt={item.titulo}
              class="w-full h-full object-cover transition-transform group-hover:scale-110 duration-700"
              loading="lazy"
              decoding="async"
            />
            <!-- Badge de categoría con color -->
            <div
              class="absolute top-4 left-4 inline-flex items-center rounded-full px-2.5 py-0.5 text-[10px] font-black text-white uppercase tracking-wider"
              style={`background-color: ${item.color};`}
            >
              {item.categoria}
            </div>
          </div>
          <!-- Contenido -->
          <div class="p-8">
            <h3 class="text-2xl font-black mb-2">{item.titulo}</h3>
            <p class="text-slate-500 text-sm mb-8 leading-relaxed">{item.descripcion}</p>
            <a
              href="#"
              class="inline-flex w-full items-center justify-center rounded-md border-2 px-4 py-2 text-sm font-bold transition-all hover:text-white"
              style={`border-color: ${item.color}; color: ${item.color};`}
              onmouseover={`this.style.backgroundColor='${item.color}'; this.style.color='white';`}
              onmouseout={`this.style.backgroundColor='transparent'; this.style.color='${item.color}';`}
            >
              {item.cta}
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
