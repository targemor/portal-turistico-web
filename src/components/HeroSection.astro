---
/**
 * HeroSection – fiel al diseño de test.jsx
 * Imagen real de Tehuacán/paisaje + overlay oscuro + barra de búsqueda
 */
---

<section id="hero" class="relative h-[80vh] flex items-center justify-center overflow-hidden">
  <!-- Background image -->
  <div class="absolute inset-0">
    <img
      src="https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?q=80&w=2000&auto=format&fit=crop"
      alt="Paisaje de Tehuacán"
      class="w-full h-full object-cover grayscale-[10%]"
      loading="eager"
      decoding="auto"
    />
    <div class="absolute inset-0 bg-slate-950/40"></div>
  </div>

  <!-- Content -->
  <div class="relative z-10 container mx-auto px-6 text-center">
    <!-- Badge -->
    <div class="inline-flex items-center rounded-full border border-white/30 bg-white/20 backdrop-blur-sm px-2.5 py-0.5 text-xs font-semibold text-white tracking-[0.2em] uppercase mb-4">
      Patrimonio de la Humanidad
    </div>

    <!-- Heading -->
    <h1 class="text-5xl md:text-8xl font-bold text-white mb-8 tracking-tighter drop-shadow-sm">
      TEHUACÁN
    </h1>

    <!-- Search bar -->
    <div class="max-w-2xl mx-auto flex gap-2 p-1.5 bg-white/95 backdrop-blur rounded-xl shadow-2xl border border-white/20">
      <div class="flex-1 flex items-center gap-2 px-3">
        <!-- Search icon -->
        <svg class="text-slate-400 shrink-0 w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/>
        </svg>
        <input
          id="hero-search"
          type="text"
          placeholder="¿Qué quieres descubrir?"
          class="flex-1 h-10 border-none bg-transparent text-sm text-slate-900 placeholder:text-slate-500 focus:outline-none focus:ring-0"
          aria-label="Buscar en Tehuacán"
        />
      </div>
      <a
        href="#destinos"
        id="hero-search-btn"
        class="inline-flex items-center justify-center rounded-lg h-10 px-6 bg-[#701010] text-white text-xs font-bold uppercase tracking-wider hover:bg-[#5a0d0d] transition-colors shadow-sm"
      >
        Buscar
      </a>
    </div>
  </div>
</section>
