---
/**
 * HeroSection – fiel al diseño de page.tsx
 * Puntos multicolor + "VIVE TEHUACÁN" + barra de búsqueda en tiempo real
 */
import SearchBar from "./react/SearchBar";

interface Props {
  data: {
    heroTitle: string;
    searchPlaceholder: string;
    heroPoster: string;
    topHoteles?: { id: number; nombre: string; direccion?: string }[];
    topRestaurantes?: { id: number; nombre: string; descripcion?: string | null; direccion?: string }[];
    imperdibles?: { id: string | number; titulo: string; categoria: string; descripcion?: string | null }[];
  };
  destinos?: { id: number; nombre: string; descripcion?: string | null; direccion?: string }[];
}

const { data, destinos = [] } = Astro.props;

/* ── Construir lista buscable plana ─────────────────────── */
type SearchableItem = {
  id: string | number;
  label: string;
  category: string;
  sublabel?: string;
  href: string;
};

const searchItems: SearchableItem[] = [
  ...(data.topHoteles ?? []).map((h) => ({
    id: h.id,
    label: h.nombre,
    category: "Hotel",
    sublabel: h.direccion,
    href: "#hoteles",
  })),
  ...(data.topRestaurantes ?? []).map((r) => ({
    id: r.id,
    label: r.nombre,
    category: "Restaurante",
    sublabel: r.descripcion ?? r.direccion,
    href: "#restaurantes",
  })),
  ...destinos.map((d) => ({
    id: d.id,
    label: d.nombre,
    category: "Destino",
    sublabel: d.descripcion ?? d.direccion,
    href: "#destinos",
  })),
  ...(data.imperdibles ?? []).map((i) => ({
    id: i.id,
    label: i.titulo,
    category: "Imperdible",
    sublabel: i.descripcion ?? i.categoria,
    href: "#imperdibles",
  })),
];
---

<section id="hero" class="relative h-[85vh] flex items-center justify-center">
  <!-- Background video -->
  <div class="absolute inset-0 overflow-hidden rounded-xl">
    <div class="w-full h-full">
      <video
        class="w-full h-full object-cover object-bottom rounded-xl"
        poster={data.heroPoster || "/assets/hero-poster.webp"}
        autoplay
        muted
        loop
        playsinline
        aria-hidden="true"
      >
        <!-- Formato moderno (menor peso) -->
        <source src="/assets/output.webm" type="video/webm" />
        <!-- Formato de respaldo para navegadores antiguos -->
        <source src="/assets/output.mp4" type="video/mp4" />
      </video>
    </div>
    <div class="absolute inset-0 bg-slate-950/30"></div>
  </div>

  <!-- Content -->
  <div class="relative z-[9999] container mx-auto px-6 text-center">    
    <!-- Heading -->
    <h1 class="text-6xl md:text-9xl font-black text-white mb-8 tracking-tighter drop-shadow-2xl">
      {data.heroTitle}
    </h1>

    <!-- Search bar (React) con datos buscables -->
    <SearchBar
      client:load
      placeholder={data.searchPlaceholder}
      items={searchItems}
    />
  </div>
</section>
