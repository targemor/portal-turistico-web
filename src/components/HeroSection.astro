---
/**
 * HeroSection – fiel al diseño de page.tsx
 * Puntos multicolor + "VIVE TEHUACÁN" + barra de búsqueda h-12
 */
import SearchIcon from "../assets/icons/SearchIcon.astro";
---

<section id="hero" class="relative h-[85vh] flex items-center justify-center overflow-hidden">
  <!-- Background video -->
  <div class="absolute inset-0">
    <div class="w-full h-full">
      <video
        class="w-full h-full object-cover rounded-xl"
        poster="/assets/hero-poster.png"
        autoplay
        muted
        loop
        playsinline
        aria-hidden="true"
      >
        <!-- Formato moderno (menor peso) -->
        <source src="/assets/output.webm" type="video/webm" />
        <!-- Formato de respaldo para navegadores antiguos -->
        <source src="/assets/output.mp4" type="video/mp4" />
      </video>
    </div>
    <div class="absolute inset-0 bg-slate-950/30"></div>
  </div>

  <!-- Content -->
  <div class="relative z-10 container mx-auto px-6 text-center">    
    <!-- Heading -->
    <h1 class="text-6xl md:text-9xl font-black text-white mb-8 tracking-tighter drop-shadow-2xl">
      VIVE TEHUACÁN
    </h1>

    <!-- Search bar -->
    <div class="max-w-2xl mx-auto flex gap-2 p-2 bg-white rounded-2xl shadow-2xl">
      <div class="flex-1 flex items-center gap-3 px-4">
        <!-- Search icon -->
        <SearchIcon class="text-slate-400 shrink-0 w-5 h-5" />
        <input
          id="hero-search"
          type="text"
          placeholder="Busca experiencias increíbles..."
          class="w-full h-12 bg-transparent outline-none text-slate-800 font-medium placeholder:text-slate-400"
          aria-label="Buscar en Tehuacán"
        />
      </div>
      <a
        href="#destinos"
        id="hero-search-btn"
        class="inline-flex items-center justify-center rounded-xl h-12 px-8 text-white text-xs font-black uppercase tracking-wider hover:opacity-90 transition-opacity shadow-sm"
        style="background-color: #E6007E;"
      >
        Buscar
      </a>
    </div>
  </div>
</section>
