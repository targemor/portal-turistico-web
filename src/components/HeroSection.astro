---
/**
 * HeroSection – Video hero + barra de búsqueda debajo del video
 */
import SearchBar from "./react/SearchBar";

interface Props {
  data: {
    titulo_principal?: string;
    texto_busqueda: string;
    imagen_principal?: string | { url: string } | null;
    mejores_hoteles?: { id: number; nombre: string; direccion?: string }[];
    mejores_restaurantes?: { id: number; nombre: string; descripcion?: string | null; direccion?: string }[];
    imperdibles?: { id: string | number; nombre: string; categorias?: {nombre: string}[]; descripcion_corta?: string | null }[];
  };
  destinos?: { id: number; nombre: string; descripcion?: string | null; direccion?: string }[];
}

const { data, destinos = [] } = Astro.props;

const posterUrl = typeof data.imagen_principal === "string"
  ? data.imagen_principal
  : (data.imagen_principal?.url || "/assets/hero-poster.webp");

/* ── Construir lista buscable plana ─────────────────────── */
type SearchableItem = {
  id: string | number;
  label: string;
  category: string;
  sublabel?: string;
  href: string;
};

const searchItems: SearchableItem[] = [
  ...(data.mejores_hoteles ?? []).map((h) => ({
    id: h.id,
    label: h.nombre,
    category: "Hotel",
    sublabel: h.direccion,
    href: `/directorio/hoteles?id=${h.id}`,
  })),
  ...(data.mejores_restaurantes ?? []).map((r) => ({
    id: r.id,
    label: r.nombre,
    category: "Restaurante",
    sublabel: r.descripcion ?? r.direccion,
    href: `/directorio/restaurantes?id=${r.id}`,
  })),
  ...destinos.map((d) => ({
    id: d.id,
    label: d.nombre,
    category: "Destino",
    sublabel: d.descripcion ?? d.direccion,
    href: `/directorio/destinos?id=${d.id}`,
  })),
  ...(data.imperdibles ?? []).map((i) => ({
    id: i.id,
    label: i.nombre || "Sin nombre",
    category: "Imperdible",
    sublabel: i.descripcion_corta ?? (i.categorias && i.categorias.length > 0 ? i.categorias[0].nombre : undefined),
    href: "#imperdibles",
  })),
];
---

<section id="hero" class="w-full bg-[#f8f9fa]">
  <!-- 1. Video Hero Banner compacto (+15% height) -->
  <div class="relative w-full h-[368px] sm:h-[437px] md:h-[530px] overflow-hidden">
    <video
      class="w-full h-full object-cover object-center"
      poster={posterUrl}
      autoplay
      muted
      loop
      playsinline
      aria-hidden="true"
    >
      <!-- Formato moderno (menor peso) -->
      <source src="/assets/output.webm" type="video/webm" />
      <!-- Formato de respaldo para navegadores antiguos -->
      <source src="/assets/output.mp4" type="video/mp4" />
    </video>
  </div>

  <!-- 2. Sección de Introducción y Búsqueda debajo del video -->
  <div class="py-12 sm:py-16 px-6 container mx-auto text-center max-w-4xl">
    <!-- Divisor multicolor -->
    <div class="flex justify-center gap-1 mb-8">
      <div class="h-1 w-8 rounded-full" style="background-color: var(--color-mex-rojo);"></div>
      <div class="h-1 w-8 rounded-full" style="background-color: var(--color-mex-rosa);"></div>
      <div class="h-1 w-8 rounded-full" style="background-color: var(--color-mex-naranja);"></div>
      <div class="h-1 w-8 rounded-full" style="background-color: var(--color-mex-purpura);"></div>
      <div class="h-1 w-8 rounded-full" style="background-color: var(--color-mex-verde);"></div>
      <div class="h-1 w-8 rounded-full" style="background-color: var(--color-mex-turquesa);"></div>
    </div>

    <!-- Cita de introducción -->
    <h1
      class="text-2xl sm:text-3xl md:text-4xl text-slate-800 leading-tight font-black tracking-tight mb-4"
      data-i18n="introText"
      data-i18n-html="true"
    >
      Descubre la <span style="color: var(--color-mex-rosa);">Cuna del Maíz</span>, un destino Patrimonio de la Humanidad que late con los <span style="color: var(--color-mex-naranja);">colores</span> de nuestra tierra.
    </h1>

    <!-- Subtítulo -->
    <p
      class="text-slate-500 text-sm sm:text-base md:text-lg mb-8 max-w-xl mx-auto font-medium"
      data-i18n="heroSubheading"
    >
      Cuéntanos qué buscas y te lo mostramos al instante
    </p>

    <!-- Barra de búsqueda (React) -->
    <SearchBar
      client:load
      items={searchItems}
    />
  </div>
</section>

