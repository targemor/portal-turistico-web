---
import BaseLayout from "../../layouts/BaseLayout.astro";
import NavBar    from "../../components/NavBar.astro";
import Footer    from "../../components/Footer.astro";
import BottomNav from "../../components/BottomNav.astro";
import DirectorioGrid from "../../components/react/DirectorioGrid";

export function getStaticPaths() {
  return [
    { params: { categoria: 'hoteles' } },
    { params: { categoria: 'restaurantes' } },
    { params: { categoria: 'destinos' } },
    { params: { categoria: 'guias' } },
  ];
}

const { categoria } = Astro.params;

let data: any[] = [];

// Claves i18n para el script del BaseLayout (se usan en data-i18n)
const tituloKey   = categoria === 'hoteles'      ? 'dirHoteles'
                  : categoria === 'restaurantes' ? 'dirRestaurantes'
                  : categoria === 'destinos'     ? 'dirDestinos'
                  : 'dirGuias';

const subtituloKey = categoria === 'hoteles'      ? 'dirHotelesSub'
                   : categoria === 'restaurantes' ? 'dirRestaurantesSub'
                   : categoria === 'destinos'     ? 'dirDestinosSub'
                   : 'dirGuiasSub';

// Valores por defecto en ES (se sobreescriben por el script i18n del cliente)
const tituloES   = categoria === 'hoteles'      ? 'HOTELES'
                 : categoria === 'restaurantes' ? 'RESTAURANTES'
                 : categoria === 'destinos'     ? 'DESTINOS TURÍSTICOS'
                 : 'GUÍAS TURÍSTICOS';

const subtituloES = categoria === 'hoteles'      ? 'Alojamiento'
                  : categoria === 'restaurantes' ? 'Gastronomía'
                  : categoria === 'destinos'     ? 'Explora Tehuacán'
                  : 'Tours y Experiencias';

if (categoria === 'hoteles') {
  data = (await import("../../data/hoteles.json")).default;
} else if (categoria === 'restaurantes') {
  data = (await import("../../data/restaurantes.json")).default;
} else if (categoria === 'destinos') {
  data = (await import("../../data/destinos-turisticos.json")).default;
} else if (categoria === 'guias') {
  data = (await import("../../data/guias-turisticos.json")).default;
}
---

<BaseLayout
  title={`${tituloES} | Portal Turístico Tehuacán`}
  description={`Descubre los mejores ${tituloES.toLowerCase()} de Tehuacán, Puebla. Cuna del Maíz y Patrimonio de la Humanidad.`}
  bodyClass="pb-20 md:pb-0"
>
  <NavBar forceBackground={true} />

  <main id="main-content" class="pt-32 pb-20">
    <div class="container mx-auto px-6">
      <!-- Header -->
      <div class="mb-12">
        <p class="text-brand font-bold text-xs uppercase tracking-[0.3em] mb-2" data-i18n={subtituloKey}>{subtituloES}</p>
        <h1 class="text-4xl font-bold tracking-tight text-slate-900" data-i18n={tituloKey}>{tituloES}</h1>
      </div>

      <h2 class="sr-only" data-i18n="dirHeadingSR">Directorio de</h2>

      <!-- Grid con highlight reactivo al ?id del URL -->
      <DirectorioGrid client:load items={data} categoria={categoria} />
    </div>
  </main>

  <Footer />
  <BottomNav />
</BaseLayout>
