---
import BaseLayout from "../../layouts/BaseLayout.astro";
import NavBar    from "../../components/NavBar.astro";
import Footer    from "../../components/Footer.astro";
import BottomNav from "../../components/BottomNav.astro";
import DirectorioGrid from "../../components/react/DirectorioGrid";
import { buildDirectorioSchemas } from "../../lib/schema";

/**
 * Cada categoría del directorio declara aquí su JSON, sus claves i18n y sus
 * textos por defecto en español (el script i18n del cliente los sobreescribe).
 */
const CATEGORIAS = {
  hoteles: {
    tituloKey: 'dirHoteles',        tituloES: 'HOTELES',
    subtituloKey: 'dirHotelesSub',  subtituloES: 'Alojamiento',
  },
  restaurantes: {
    tituloKey: 'dirRestaurantes',       tituloES: 'RESTAURANTES',
    subtituloKey: 'dirRestaurantesSub', subtituloES: 'Gastronomía',
  },
  destinos: {
    tituloKey: 'dirDestinos',       tituloES: 'DESTINOS TURÍSTICOS',
    subtituloKey: 'dirDestinosSub', subtituloES: 'Explora Tehuacán',
  },
  guias: {
    tituloKey: 'dirGuias',       tituloES: 'GUÍAS TURÍSTICOS',
    subtituloKey: 'dirGuiasSub', subtituloES: 'Tours y Experiencias',
  },
  touroperadores: {
    tituloKey: 'dirTouroperadores',       tituloES: 'TOUROPERADORES',
    subtituloKey: 'dirTouroperadoresSub', subtituloES: 'Experiencias Guiadas',
  },
} as const;

type Categoria = keyof typeof CATEGORIAS;

// Astro extrae getStaticPaths a su propio módulo, así que no puede leer
// CATEGORIAS: las rutas se listan aquí y deben coincidir con esas claves.
export function getStaticPaths() {
  return [
    { params: { categoria: 'hoteles' } },
    { params: { categoria: 'restaurantes' } },
    { params: { categoria: 'destinos' } },
    { params: { categoria: 'guias' } },
    { params: { categoria: 'touroperadores' } },
  ];
}

const categoria = Astro.params.categoria as Categoria;
const { tituloKey, tituloES, subtituloKey, subtituloES } = CATEGORIAS[categoria];

let data: any[] = [];

if (categoria === 'hoteles') {
  data = (await import("../../data/hoteles.json")).default;
} else if (categoria === 'restaurantes') {
  data = (await import("../../data/restaurantes.json")).default;
} else if (categoria === 'destinos') {
  data = (await import("../../data/destinos-turisticos.json")).default;
} else if (categoria === 'guias') {
  data = (await import("../../data/guias-turisticos.json")).default;
} else if (categoria === 'touroperadores') {
  data = (await import("../../data/touroperadores.json")).default;
}
---

<BaseLayout
  title={`${tituloES} | Portal Turístico Tehuacán`}
  description={`Descubre los mejores ${tituloES.toLowerCase()} de Tehuacán, Puebla. Cuna del Maíz y Patrimonio de la Humanidad.`}
  canonical={`/directorio/${categoria}`}
  jsonLd={buildDirectorioSchemas(categoria, data)}
  bodyClass="pb-20 md:pb-0"
>
  <NavBar forceBackground={true} />

  <main id="main-content" class="pt-10 sm:pt-12 pb-12">
    <div class="container mx-auto px-6">
      <!-- Header -->
      <div class="mb-6">
        <p class="text-brand font-bold text-xs uppercase tracking-[0.3em] mb-1.5" data-i18n={subtituloKey}>{subtituloES}</p>
        <h1 class="text-4xl font-bold tracking-tight text-slate-900" data-i18n={tituloKey}>{tituloES}</h1>
      </div>

      <h2 class="sr-only" data-i18n="dirHeadingSR">Directorio de</h2>

      <!-- Grid con highlight reactivo al ?id del URL -->
      <DirectorioGrid client:load items={data} categoria={categoria} />
    </div>
  </main>

  <Footer />
  <BottomNav />
</BaseLayout>
