---
/**
 * index.astro – Página principal del Portal Turístico Tehuacán
 *
 * Estructura fiel a test.jsx refactorizada en componentes Astro:
 * - NavBar          → header transparente → blur al scroll
 * - HeroSection     → imagen + overlay + barra búsqueda
 * - IntroSection    → cita minimalista con divisor rojo
 * - ImperdiblesSection → bento grid + tabs por categoría
 * - EventosSection    → lista de próximos eventos
 * - ExploraSection  → bento grid + tabs por categoría
 * - HotelesSection  → cards de hoteles con datos JSON
 * - RestaurantesSection → cards de restaurantes con datos JSON
 * - GuiasSection    → cards de guías con datos JSON
 * - Footer          → dark slate-950
 * - BottomNav       → nav móvil fijo + FAB
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import NavBar from "../components/NavBar.astro";
import HeroSection from "../components/HeroSection.astro";
import IntroSection from "../components/IntroSection.astro";
import ImperdiblesSection from "../components/ImperdiblesSection.astro";
import ItinerarioTabs from "../components/ItinerarioTabs.astro";
import EventosSection from "../components/EventosSection.astro";
import HotelesSection from "../components/HotelesSection.astro";
import RestaurantesSection from "../components/RestaurantesSection.astro";
import GuiasSection from "../components/GuiasSection.astro";
import Footer from "../components/Footer.astro";
import BottomNav from "../components/BottomNav.astro";

import homePageData from "../data/home-page.json";
import guias from "../data/guias-turisticos.json";
import destinos from "../data/destinos-turisticos.json";
---

<BaseLayout
  title="Portal Turístico Tehuacán | Cuna del Maíz"
  description="Portal Turístico Tehuacán – Descubre la Cuna del Maíz y Patrimonio de la Humanidad. Hoteles, restaurantes, destinos y guías certificados en Tehuacán, Puebla."
>
  <!-- Preload del LCP (imagen hero) — específico de esta página -->
  <link
    slot="head"
    rel="preload"
    as="image"
    fetchpriority="high"
    href="/assets/hero-poster.webp"
    type="image/webp"
  />

  <NavBar />

  <main id="main-content">
    <!-- HeroSection: video + cita intro + buscador -->
    <HeroSection data={homePageData} destinos={destinos} />

    <!-- Bento grid + Imperdibles por categoría -->
    <ImperdiblesSection imperdibles={homePageData.imperdibles} />

    <!-- Sección de Itinerarios sugeridos -->
    <section id="itinerarios" class="py-12 bg-slate-50/50">
      <ItinerarioTabs />
    </section>

    <!-- Próximos Eventos -->
    <EventosSection />

    <!-- Hoteles (datos desde JSON) -->
    <HotelesSection hoteles={homePageData.mejores_hoteles} />

    <!-- Restaurantes (datos desde JSON) -->
    <RestaurantesSection restaurantes={homePageData.mejores_restaurantes} />

    <!-- Guías turísticos (datos desde JSON) -->
    <GuiasSection guias={guias} />
  </main>

  <!-- Footer dark -->
  <Footer />

  <!-- Bottom nav móvil + FAB -->
  <BottomNav />
</BaseLayout>
